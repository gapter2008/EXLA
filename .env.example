# Next.js base URL for server actions (optional in dev)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# OpenAI (required for pitch generation)
OPENAI_API_KEY=sk-...

# If using Prisma locally instead of Supabase
DATABASE_URL=postgresql://user:password@localhost:5432/exla


