// If using Prisma + Postgres locally instead of Supabase
// Not required when using Supabase. Provided for optional migration route.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Brand {
  id           String  @id @default(uuid())
  brand_name   String
  contact_email String?
  platform     String?
  industry     String?
  notes        String?
}

model WaitlistUser {
  id    String @id @default(uuid())
  name  String
  email String @unique
  createdAt DateTime @default(now())
}


